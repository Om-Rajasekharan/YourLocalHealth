NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_OPENWEATHER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CENSUS_API_KEY=
NEXT_PUBLIC_LOOKER_STUDIO_EMBED_URL=
NEXT_PUBLIC_TABLEAU_EMBED_URL=
ENABLE_AI_ASSISTANT=true
ENABLE_AI_PLAN=true
ENABLE_MODEL_EVALUATION=true
ENABLE_EXPERIMENTAL_SYMPTOM_SIGNALS=true
ENABLE_ML_MODEL_SERVING=false
ML_SERVICE_URL=http://127.0.0.1:8000
ENABLE_RAG_KNOWLEDGE_BASE=false

# Only needed to run scripts/seed-knowledge-base.mjs -- never used by the
# running app itself. Never commit this or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If unset, OpenTelemetry spans export to stdout instead of a
# hosted backend. Point this at Honeycomb/Grafana Cloud/etc. to switch.
OTEL_EXPORTER_OTLP_ENDPOINT=
