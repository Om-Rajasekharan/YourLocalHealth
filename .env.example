NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_OPENWEATHER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CENSUS_API_KEY=
NEXT_PUBLIC_LOOKER_STUDIO_EMBED_URL=
NEXT_PUBLIC_TABLEAU_EMBED_URL=
ENABLE_AI_ASSISTANT=true
ENABLE_AI_PLAN=true
ENABLE_MODEL_EVALUATION=true
ENABLE_EXPERIMENTAL_SYMPTOM_SIGNALS=true
ENABLE_ML_MODEL_SERVING=false
ML_SERVICE_URL=http://127.0.0.1:8000
ENABLE_RAG_KNOWLEDGE_BASE=false

# Used by scripts/seed-knowledge-base.mjs (one-time, offline), and by the
# running app's /api/personal-risk-calibration route to compute a pooled
# cross-user baseline (bypasses RLS server-side only; never exposed to the
# browser, since it isn't NEXT_PUBLIC_-prefixed). Without it, that route
# still works, it just always falls back to a neutral prior instead of a
# real population baseline. Never commit this value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If unset, OpenTelemetry spans export to stdout instead of a
# hosted backend. Point this at Honeycomb/Grafana Cloud/etc. to switch.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Proactive risk alerts (opt-in per saved location, emailed once when a
# location's risk newly crosses into High). All three are server-only.
#
# From a free Resend account (resend.com) -- without it, /api/cron/check-alerts
# will throw when it tries to actually send an email.
RESEND_API_KEY=
# Any random string. Must match the same value set as the CRON_SECRET
# GitHub Actions repo secret (.github/workflows/check-alerts.yml) -- guards
# /api/cron/check-alerts so it can't be triggered by anyone who finds the URL.
CRON_SECRET=
# Any random string. Signs the one-click unsubscribe link in alert emails.
ALERT_UNSUBSCRIBE_SECRET=
